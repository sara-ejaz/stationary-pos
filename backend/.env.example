# Server port
PORT=8000

# Origins allowed to call this API (comma separated).
# Any http://localhost:<port> origin is allowed automatically in development.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Session lifetime in seconds (8 hours = one shift)
TOKEN_TTL_SECONDS=28800

# Seed staff passwords (change before deploying)
ADMIN_PASSWORD=Admin@123
CASHIER_PASSWORD=Cashier@123
INVENTORY_PASSWORD=Inventory@123

# MongoDB Atlas connection string (used once the staff store moves to MongoDB)
mongodb=mongodb+srv://<user>:<password>@cluster0.2urmdt0.mongodb.net/foji_pos
